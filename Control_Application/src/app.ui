         <property name="styleSheet">
          <string notr="true">/* Branding / App Title Styling */
QLabel {
    color: #00F3FF; /* Cyan to match your accent colors */
    font: bold 8pt &quot;Ubuntu Sans&quot;;
    background-color: transparent; /* Ensures no weird boxes */
    border: none; /* Removes any default borders */
    border-top: 1px solid #2A2A35; /* Creates a subtle line separating the logo from the spacer */
    padding-top: 15px; /* Pushes the text down away from the line */
    padding-bottom: 5px;
    qproperty-alignment: AlignCenter; /* Forces the text perfectly to the center */
    letter-spacing: 2px; /* Spreads the letters out for a cinematic, high-tech look */
}</string>
         </property>
