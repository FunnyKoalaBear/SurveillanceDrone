  <property name="styleSheet">
   <string notr="true">/* 1. Global Background and Text */
QMainWindow, QWidget {
    background-color: #121212; /* Deep dark grey/black */
    color: #E0E0E0; /* Off-white text for readability */
    font-family: &quot;Segoe UI&quot;, &quot;Helvetica Neue&quot;, sans-serif;
}

/* 2. Layout Panels (Your QFrames) */
QFrame {
    background-color: #1E1E24; /* Slightly lighter grey for panels */
    border: 1px solid #2A2A35;
    border-radius: 8px;
}

/* 3. The Video Feed Label */
/* Assuming you name your camera label &quot;video_feed_label&quot; */
QLabel#video_feed_label {
    background-color: #000000;
    border: 2px solid #00F3FF; /* Neon Cyan tactical border */
    border-radius: 4px;
}

/* 4. Standard Text Labels (Telemetry data) */
QLabel {
    background-color: transparent;
    border: none;
    font-size: 13px;
}

/* 5. Modern Interactive Buttons */
QPushButton {
    background-color: #2D2D3A;
    border: 1px solid #00F3FF; /* Cyan outline */
    color: #00F3FF; /* Cyan text */
    padding: 8px 16px;
    border-radius: 4px;
    font-weight: bold;
	font: bold 11pt &quot;Ubuntu Sans&quot;;

    letter-spacing: 1px;
}

/* Button Hover Animation */
QPushButton:hover {
    background-color: #00F3FF; /* Fill solid cyan on hover */
    color: #121212; /* Invert text to black */
}

/* Button Click Animation */
QPushButton:pressed {
    background-color: #00B8D4;
    border: 1px solid #00B8D4;
}

/* 6. The Console Output (Read-only text box) */
QTextEdit {
    background-color: #0A0A0C; /* Pitch black */
    color: #00FF41; /* Hacker terminal green */
    border: 1px solid #2A2A35;
    font-family: &quot;Courier New&quot;, monospace;
    padding: 10px;
    border-radius: 4px;
}

/* General Text Labels (For titles like &quot;Battery&quot;, &quot;Altitude&quot;) */
QLabel {
    background-color: #1A1A24; /* Slightly lighter than the background */
    color: #A0A0B0; /* Muted grey/white text so it isn't blinding */
    padding: 6px 12px;
    border-radius: 4px;
    font-size: 13px;
    border-left: 3px solid #2A2A35; /* Subtle grey edge to give it structure */
}


/* 1. GroupBox Main Body (The Secret Fix) */
QGroupBox {
    color: #00F3FF;
    border: 1px solid #2A2A35;
    border-radius: 6px;
    margin-top: 25px; 
    
    /* Apply the massive font to the WHOLE box so the title inherits it */
    font:  16pt &quot;Ubuntu Sans&quot;; 
}

/* 2. GroupBox Title Alignment */
QGroupBox::title {
    subcontrol-origin: margin; 
    subcontrol-position: top left;
    padding: 0 8px; 
    left: 1px; 
    background-color: #1E1E24; 
    /* Notice: No font commands here anymore! */
}

/* 3. GroupBox Data Labels */
QGroupBox QLabel {
    /* Force the labels back down so they don't stay giant */
    font: 12pt &quot;Ubuntu Sans&quot;;
    font-weight: normal; 
}


/* Immunity Shield for the Logo Label */
QLabel#app_logo {
background-color: transparent;
border: none;
padding: 0px;
margin: 0px;
/* If there is text, force it back to standard grey/white: */
color: #E0E0E0;
}</string>
